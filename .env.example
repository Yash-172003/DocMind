# === PostgreSQL ===
POSTGRES_USER=docmind
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=docmind_db

# === Redis ===
REDIS_PASSWORD=changeme_in_production

# === App ===
DATABASE_URL=postgresql+asyncpg://docmind:changeme_in_production@localhost:5432/docmind_db
API_KEY=changeme_in_production

# === Langfuse (self-hosted observability) ===
# Isolated from the app's own Postgres/Redis above — see docker-compose.yml.
LANGFUSE_POSTGRES_PASSWORD=changeme_in_production
LANGFUSE_REDIS_PASSWORD=changeme_in_production
LANGFUSE_CLICKHOUSE_PASSWORD=changeme_in_production
LANGFUSE_MINIO_ROOT_PASSWORD=changeme_in_production
# Generate with: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=changeme_run_openssl_rand_hex_32
# Generate with: openssl rand -base64 32
LANGFUSE_SALT=changeme_run_openssl_rand_base64_32
LANGFUSE_NEXTAUTH_SECRET=changeme_run_openssl_rand_base64_32
# Auto-provisioned login for the Langfuse UI at http://localhost:3000
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=Yash
LANGFUSE_INIT_USER_PASSWORD=changeme_in_production
